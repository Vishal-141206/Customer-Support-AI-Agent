cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
.venv/
venv/
ENV/
env/

# AgentCore local/generated files
.bedrock_agentcore/
.bedrock_agentcore.yaml

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test/cache
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/
EOF